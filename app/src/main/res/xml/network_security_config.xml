<?xml version="1.0" encoding="utf-8"?>
<!-- Android domain-config cannot represent user-selected private IP ranges.
     The shared OkHttp client enforces numeric private/loopback HTTP only,
     before transmission, and refuses redirects (including WebSocket tickets).
     Platform cleartext permission is necessary but is NOT the trust policy.
     Never create an unguarded production HTTP client. See ADR 0005. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
