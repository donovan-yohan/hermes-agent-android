<?xml version="1.0" encoding="utf-8"?>
<!-- Remote supports HTTP(S) hostnames and IPs, matching Desktop.
     HTTP/WS is unencrypted: this is platform permission, not a host trust policy.
     All production HTTP clients share existing redirect/proxy auth safeguards;
     HTTPS certificate verification is unchanged. See ADR 0005. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
