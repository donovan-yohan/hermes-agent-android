+''')
+        adb.chmod(0o755)
+        self.env = dict(os.environ, PATH=f"{directory}:{os.environ['PATH']}",
+                        ADB_LOG=str(self.log))
+
+    def prepare(self):
+        return subprocess.run(["bash", str(ROOT / "scripts/prepare-ci-emulator.sh")],
+                              env=self.env, capture_output=True, text=True)
